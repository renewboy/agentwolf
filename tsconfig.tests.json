{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@agent-arena/contracts": ["./vendor/agent-arena-core/packages/contracts/src/index.ts"],
      "@agent-arena/game-runtime": ["./vendor/agent-arena-core/packages/game-runtime/src/index.ts"],
      "@agent-arena/ruleset": ["./vendor/agent-arena-core/packages/ruleset/src/index.ts"],
      "@agentwolf/contracts": ["./packages/contracts/src/index.ts"],
      "@agentwolf/assets": ["./packages/assets/src/index.ts"],
      "@agentwolf/assets/prompts": ["./packages/assets/src/prompts.ts"],
      "@agentwolf/assets/player-skills": ["./packages/assets/src/player-skills.ts"],
      "@agentwolf/game-engine": ["./packages/game-engine/src/index.ts"],
      "@agentwolf/acp": ["./packages/acp/src/index.ts"]
    },
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "packages/*/tests/**/*.ts",
    "apps/server/tests/**/*.ts",
    "apps/web/tests/**/*.ts",
    "apps/web/tests/**/*.tsx",
    "e2e/**/*.ts",
    "scripts/**/*.test.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
