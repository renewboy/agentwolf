{
  "threshold": 4,
  "minLines": 12,
  "minTokens": 80,
  "mode": "strict",
  "reporters": ["console", "threshold"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-types/**",
    "**/coverage/**",
    "**/tests/**",
    "**/*.d.ts"
  ],
  "format": ["typescript", "tsx", "javascript"]
}
