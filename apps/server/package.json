{
  "name": "@agentwolf/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch --exclude '**/dist/**' src/bin.ts",
    "start": "node dist/bin.js",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@agent-arena/trajectory": "workspace:*",
    "@agentclientprotocol/sdk": "1.4.0",
    "@agentwolf/acp": "workspace:*",
    "@agentwolf/assets": "workspace:*",
    "@agentwolf/contracts": "workspace:*",
    "@agentwolf/game-engine": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "11.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0"
  }
}
